* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.mp4 binary
*.bin binary
*.npy binary
*.pth binary
*.safetensors binary

# Frozen research receipts carry SHA-256 of raw bytes; preserve their line endings.
research/mamba3h/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
