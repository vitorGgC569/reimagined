# Dockerfile.industrial
FROM nvidia/cuda:12.2-devel-ubuntu22.04 AS builder

# Build dependencies
RUN apt-get update && apt-get install -y \
    cmake \
    ninja-build \
    gcc-12 g++-12 \
    python3-dev \
    python3-pip \
    pybind11-dev \
    libopenmpi-dev \
    && rm -rf /var/lib/apt/lists/*

# Build NSOS
COPY . /src
WORKDIR /src

# Configurar ambiente Python e dependências
RUN pip3 install numpy torch pytest hypothesis

# Build Release
RUN cmake -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_CXX_COMPILER=g++-12 \
    -DNSOS_BUILD_TESTS=ON \
    -G Ninja

RUN cmake --build build --target nsos_ext -j$(nproc)

# Runtime image
FROM nvidia/cuda:12.2-runtime-ubuntu22.04

RUN apt-get update && apt-get install -y \
    libgomp1 \
    libopenmpi3 \
    python3-minimal \
    python3-numpy \
    && rm -rf /var/lib/apt/lists/*

# Copy built artifacts
COPY --from=builder /src/build/*.so /usr/local/lib/python3.10/dist-packages/
COPY --from=builder /src/OXN/scripts /app/scripts

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python3 -c "import nsos_ext; print('OK')" || exit 1

ENV LD_LIBRARY_PATH=/usr/local/lib:$LD_LIBRARY_PATH
ENV PYTHONPATH=/usr/local/lib/python3.10/dist-packages:$PYTHONPATH

WORKDIR /app
CMD ["python3", "scripts/serve_oxn.py"]
