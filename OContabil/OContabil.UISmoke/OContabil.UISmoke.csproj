<Project Sdk="Microsoft.NET.Sdk">
  <!-- UI smoke/validation harness for the OContabil WPF app (FlaUI UI Automation).
       Standalone: NOT part of OContabil.sln; launches the built OContabil.exe,
       drives first-run wizard -> login -> each page, and screenshots every state
       so the new "Razão" theme can be visually validated function-by-function. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>false</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" Version="4.0.0" />
  </ItemGroup>
</Project>
