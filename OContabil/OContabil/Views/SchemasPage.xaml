<UserControl x:Class="OContabil.Views.SchemasPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             Loaded="OnLoaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Lista de schemas -->
        <Border Grid.Column="0" Style="{DynamicResource Card}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="Schemas de Extração" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" Style="{DynamicResource BtnPrimary}"
                            Content="Novo" Padding="10,4" FontSize="11" Click="OnNew"/>
                </DockPanel>
                <ListBox x:Name="lstSchemas"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource TextPrimary}"
                         SelectionChanged="OnSelected">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,8" Background="Transparent" BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource Border}">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <Border DockPanel.Dock="Right" CornerRadius="3" Padding="4,1"
                                                Background="{DynamicResource InfoBg}"
                                                Visibility="{Binding IsSystemVisibility}">
                                            <TextBlock Text="SISTEMA" FontSize="9" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Info}"/>
                                        </Border>
                                    </DockPanel>
                                    <TextBlock Text="{Binding DocumentType}" FontSize="10"
                                               Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Editor -->
        <Border Grid.Column="2" Style="{DynamicResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Detalhes do Schema" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="Define os campos que a IA tenta extrair em documentos deste tipo. Aceita listas de strings (rótulos GLiNER) ou estrutura JSON completa."
                               FontSize="11" Foreground="{DynamicResource TextMuted}"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Nome" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtName" Style="{DynamicResource InputBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Tipo de Documento" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="cmbDocType" Padding="8,6"
                                          Background="{DynamicResource BgInput}"
                                          Foreground="{DynamicResource TextPrimary}">
                                    <ComboBoxItem>NF-e</ComboBoxItem>
                                    <ComboBoxItem>NFS-e</ComboBoxItem>
                                    <ComboBoxItem>DANFE</ComboBoxItem>
                                    <ComboBoxItem>Boleto</ComboBoxItem>
                                    <ComboBoxItem>ExtratoBancario</ComboBoxItem>
                                    <ComboBoxItem>Holerite</ComboBoxItem>
                                    <ComboBoxItem>DARF</ComboBoxItem>
                                    <ComboBoxItem>CT-e</ComboBoxItem>
                                    <ComboBoxItem>ComprovantePIX</ComboBoxItem>
                                    <ComboBoxItem>Outro</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Cliente Específico (opcional)" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cmbClient" Padding="8,6" Margin="0,0,0,10"
                                  Background="{DynamicResource BgInput}"
                                  Foreground="{DynamicResource TextPrimary}"
                                  DisplayMemberPath="Name" SelectedValuePath="Id"/>

                        <TextBlock Text="JSON do Schema" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtJson" Style="{DynamicResource InputBox}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="11"
                                 MinHeight="300"/>
                        <TextBlock Text="Ex.: { &quot;fields&quot;: [&quot;numero_nota&quot;, &quot;valor_total&quot;, &quot;data_emissao&quot;] }"
                                   FontSize="10" Foreground="{DynamicResource TextMuted}"
                                   FontStyle="Italic" Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>

                <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="False">
                    <Button Style="{DynamicResource BtnGhost}" Content="Excluir"
                            DockPanel.Dock="Left" Width="100" Click="OnDelete"/>
                    <Button Style="{DynamicResource BtnPrimary}" Content="Salvar"
                            DockPanel.Dock="Right" Width="120" Click="OnSave"/>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
