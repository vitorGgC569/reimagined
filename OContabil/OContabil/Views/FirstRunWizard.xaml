<Window x:Class="OContabil.Views.FirstRunWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bem-vindo ao OContabil" Height="620" Width="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgPrimary}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI"
        ResizeMode="NoResize">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <DockPanel>
                <Image Source="/Assets/logo.png" Width="44" Height="44" DockPanel.Dock="Left" Margin="0,0,16,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Bem-vindo ao OContabil" FontSize="22" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock x:Name="txtStepInfo" Text="Etapa 1 de 3 — Dados da empresa" FontSize="12"
                               Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <Border Grid.Row="1" Style="{DynamicResource Card}" Padding="24">
            <Grid>
                <!-- Step 1: Empresa -->
                <StackPanel x:Name="pnlStep1">
                    <TextBlock Text="Identifique sua empresa" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                    <TextBlock Text="Estes dados aparecem em todos os relatórios e arquivos de exportação."
                               FontSize="11" Foreground="{DynamicResource TextMuted}"
                               TextWrapping="Wrap" Margin="0,0,0,20"/>

                    <TextBlock Text="Razão social *" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtCompanyName" Style="{DynamicResource InputBox}" Margin="0,0,0,16"/>

                    <TextBlock Text="CNPJ" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtCompanyCnpj" Style="{DynamicResource InputBox}" Margin="0,0,0,16"/>

                    <TextBlock Text="Pasta de trabalho (importações futuras)" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="..." Width="36" Padding="6,4"
                                Click="OnPickWorkFolder"/>
                        <TextBox x:Name="txtWorkFolder" Style="{DynamicResource InputBox}" Margin="0,0,8,0"/>
                    </DockPanel>
                </StackPanel>

                <!-- Step 2: Admin -->
                <StackPanel x:Name="pnlStep2" Visibility="Collapsed">
                    <TextBlock Text="Crie o usuário administrador" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                    <TextBlock Text="A senha precisa ter pelo menos 8 caracteres. O usuário padrão admin/admin será desabilitado."
                               FontSize="11" Foreground="{DynamicResource TextMuted}"
                               TextWrapping="Wrap" Margin="0,0,0,20"/>

                    <TextBlock Text="Nome completo *" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtAdminName" Style="{DynamicResource InputBox}" Margin="0,0,0,16"/>

                    <TextBlock Text="Nome de usuário *" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtAdminUser" Style="{DynamicResource InputBox}" Margin="0,0,0,16"/>

                    <TextBlock Text="E-mail" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtAdminEmail" Style="{DynamicResource InputBox}" Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Senha *" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                            <PasswordBox x:Name="pwdAdmin" Style="{DynamicResource InputPassword}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Confirme a senha *" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                            <PasswordBox x:Name="pwdAdminConfirm" Style="{DynamicResource InputPassword}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Step 3: Dependências -->
                <StackPanel x:Name="pnlStep3" Visibility="Collapsed">
                    <TextBlock Text="Verificação de dependências" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                    <TextBlock Text="Componentes opcionais para OCR e processamento avançado."
                               FontSize="11" Foreground="{DynamicResource TextMuted}"
                               TextWrapping="Wrap" Margin="0,0,0,20"/>

                    <Border x:Name="pnlPython" Background="{DynamicResource BgElevated}" Padding="14" CornerRadius="6" Margin="0,0,0,12">
                        <DockPanel>
                            <TextBlock x:Name="txtPythonIcon" Text="?" FontSize="22" DockPanel.Dock="Left"
                                       Margin="0,0,14,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMuted}"/>
                            <StackPanel>
                                <TextBlock Text="Python 3.11+" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock x:Name="txtPythonStatus" Text="Verificando..." FontSize="11"
                                           Foreground="{DynamicResource TextMuted}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border x:Name="pnlTesseract" Background="{DynamicResource BgElevated}" Padding="14" CornerRadius="6" Margin="0,0,0,12">
                        <DockPanel>
                            <TextBlock x:Name="txtTessIcon" Text="?" FontSize="22" DockPanel.Dock="Left"
                                       Margin="0,0,14,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMuted}"/>
                            <StackPanel>
                                <TextBlock Text="Tesseract OCR (opcional)" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock x:Name="txtTessStatus" Text="Verificando..." FontSize="11"
                                           Foreground="{DynamicResource TextMuted}"/>
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Content="Como instalar"
                                    Style="{DynamicResource BtnGhost}" Padding="8,4" FontSize="10"
                                    Click="OnTesseractHelp" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <TextBlock Text="O OContabil funciona mesmo sem essas dependências usando o motor Regex offline, porém com menor precisão em PDFs digitalizados."
                               FontSize="11" Foreground="{DynamicResource TextMuted}"
                               TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,20,0,0" LastChildFill="False">
            <Button x:Name="btnBack" Style="{DynamicResource BtnGhost}" Content="Voltar"
                    Width="100" DockPanel.Dock="Left" Click="OnBack" Visibility="Collapsed"/>
            <Button x:Name="btnNext" Style="{DynamicResource BtnPrimary}" Content="Avançar"
                    Width="120" DockPanel.Dock="Right" Click="OnNext"/>
        </DockPanel>
    </Grid>
</Window>
