<Window x:Class="OContabil.Views.ShortcutsHelpDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Atalhos de teclado" Height="440" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimary}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI"
        ResizeMode="NoResize">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Atalhos de teclado" FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Text="Pressione F1 a qualquer momento para abrir esta tela."
                       FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{DynamicResource Card}">
            <ItemsControl x:Name="lstShortcuts">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,4">
                            <Border Background="{DynamicResource BgElevated}" CornerRadius="4"
                                    Padding="8,2" DockPanel.Dock="Left" Margin="0,0,12,0">
                                <TextBlock Text="{Binding Keys}" FontFamily="Consolas" FontSize="11"
                                           FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            </Border>
                            <TextBlock Text="{Binding Description}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Button Grid.Row="2" Style="{DynamicResource BtnPrimary}" Content="Fechar"
                Width="120" HorizontalAlignment="Right" Margin="0,16,0,0"
                Click="OnClose"/>
    </Grid>
</Window>
