<Window x:Class="OContabil.Views.ExportFormatDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exportar Documentos" Height="520" Width="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimary}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI"
        ResizeMode="NoResize">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Exportar Documentos" FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Text="Escolha o formato de exportação." FontSize="12"
                       Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0"/>
        </StackPanel>

        <ListBox x:Name="lstFormats" Grid.Row="1"
                 Background="{DynamicResource BgCard}"
                 Foreground="{DynamicResource TextPrimary}"
                 BorderBrush="{DynamicResource Border}"
                 FontSize="13">
            <ListBoxItem Tag="Excel">
                <StackPanel>
                    <TextBlock Text="Excel (.xlsx)" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="Planilha com abas Resumo, Documentos e Por Cliente." FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Csv">
                <StackPanel>
                    <TextBlock Text="CSV (.csv)" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="UTF-8 com separador ; (compatível com Excel pt-BR)." FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Sped">
                <StackPanel>
                    <TextBlock Text="SPED Fiscal (.txt)" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="Arquivo no padrão ATO COTEPE/ICMS 44/2018 — blocos 0, C e 9." FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Dominio">
                <StackPanel>
                    <TextBlock Text="Domínio Sistemas (.txt)" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="Layout pipe-delimitado para importação de lançamentos contábeis." FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Pdf">
                <StackPanel>
                    <TextBlock Text="PDF de Conferência (.pdf)" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="Relatório imprimível com cabeçalho da empresa e totalizadores." FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                </StackPanel>
            </ListBoxItem>
        </ListBox>

        <CheckBox x:Name="chkOnlyValidated" Grid.Row="2" Margin="0,16,0,0"
                  Content="Exportar somente documentos validados"
                  Foreground="{DynamicResource TextPrimary}" FontSize="12"
                  IsChecked="True"/>

        <DockPanel Grid.Row="3" Margin="0,20,0,0" LastChildFill="False">
            <Button Style="{DynamicResource BtnGhost}" Content="Cancelar" Width="100"
                    DockPanel.Dock="Left" Click="OnCancel"/>
            <Button Style="{DynamicResource BtnPrimary}" Content="Exportar" Width="120"
                    DockPanel.Dock="Right" Click="OnConfirm"/>
        </DockPanel>
    </Grid>
</Window>
