<Window x:Class="OContabil.Views.WebShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="OContabil" Height="900" Width="1440"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="#FBFAF7">
    <!-- Hosts the OContabil design (WebUI/) so the app renders the exact
         prototype.  Pixel-perfect to the design; wired to the C# services via
         the WebView2 host bridge (added incrementally). -->
    <wv2:WebView2 x:Name="web"/>
</Window>
