<UserControl x:Class="OContabil.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══ Empresa ═══ -->
            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Style="{DynamicResource Card}">
                <StackPanel>
                    <TextBlock Text="Dados da Empresa" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                    <TextBlock Text="Aparecem nos relatórios PDF, SPED e arquivos de exportação." FontSize="11"
                               Foreground="{DynamicResource TextMuted}" Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Razão Social" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtCompanyName" Style="{DynamicResource InputBox}"
                                     LostFocus="OnCompanyChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="CNPJ" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtCompanyCnpj" Style="{DynamicResource InputBox}"
                                     LostFocus="OnCompanyChanged"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══ Motor IA ═══ -->
            <Border Grid.Row="2" Grid.Column="0" Style="{DynamicResource Card}">
                <StackPanel>
                    <TextBlock Text="Motor de IA" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                    <TextBlock Text="GLiNER 2 / ONNX Runtime / fallback Regex" FontSize="11"
                               Foreground="{DynamicResource TextMuted}" Margin="0,0,0,20"/>

                    <TextBlock Text="Engine preferido" FontSize="11.5" FontWeight="Medium"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="cmbEngine" Padding="8,6" FontSize="11.5" Margin="0,0,0,12"
                              Background="{DynamicResource BgInput}" Foreground="{DynamicResource TextPrimary}"
                              SelectionChanged="OnEngineChanged">
                        <ComboBoxItem Tag="Auto">Auto (ONNX → Python → Regex)</ComboBoxItem>
                        <ComboBoxItem Tag="Onnx">ONNX (nativo, mais rápido)</ComboBoxItem>
                        <ComboBoxItem Tag="Python">Python bridge (compatibilidade ampla)</ComboBoxItem>
                        <ComboBoxItem Tag="Regex">Regex (offline, determinístico)</ComboBoxItem>
                    </ComboBox>

                    <TextBlock Text="Modelo GLiNER" FontSize="11.5" FontWeight="Medium"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="cmbModel" SelectedIndex="0" Padding="8,6" FontSize="11.5" Margin="0,0,0,12"
                              Background="{DynamicResource BgInput}" Foreground="{DynamicResource TextPrimary}"
                              SelectionChanged="OnModelChanged">
                        <ComboBoxItem Tag="fastino/gliner2-base-v1">gliner2-base-v1 (205M params)</ComboBoxItem>
                        <ComboBoxItem Tag="fastino/gliner2-large-v1">gliner2-large-v1 (340M params)</ComboBoxItem>
                    </ComboBox>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Threshold" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtThreshold" Style="{DynamicResource InputBox}"
                                     LostFocus="OnThresholdChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Timeout (s)" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtTimeout" Style="{DynamicResource InputBox}"
                                     LostFocus="OnTimeoutChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Retries" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtRetries" Style="{DynamicResource InputBox}"
                                     LostFocus="OnRetriesChanged"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Python" FontSize="11.5" FontWeight="Medium"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,16,0,4"/>
                    <TextBlock x:Name="txtPythonStatus" Text="" FontSize="10.5"
                               Foreground="{DynamicResource TextMuted}" FontFamily="Consolas"/>
                </StackPanel>
            </Border>

            <!-- ═══ Certificado Digital ═══ -->
            <Border Grid.Row="2" Grid.Column="2" Style="{DynamicResource Card}">
                <StackPanel>
                    <TextBlock Text="Certificado Digital" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                    <TextBlock Text="Certificado A1 (.pfx) para acesso a SEFAZ" FontSize="11"
                               Foreground="{DynamicResource TextMuted}" Margin="0,0,0,16"/>

                    <Border x:Name="pnlCertStatus" Background="{DynamicResource BgElevated}"
                            CornerRadius="6" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="txtCertStatus" Text="Nenhum certificado carregado"
                                       FontSize="12" FontWeight="Medium"
                                       Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock x:Name="txtCertInfo" Text="" FontSize="10"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Button Style="{DynamicResource BtnPrimary}" Content="Carregar Certificado (.pfx)"
                            Click="OnLoadCert" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- ═══ Sessão ═══ -->
            <Border Grid.Row="4" Grid.Column="0" Style="{DynamicResource Card}">
                <StackPanel>
                    <TextBlock Text="Sessão e Alertas" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                    <TextBlock Text="Timeout de inatividade e detecção de documentos parados." FontSize="11"
                               Foreground="{DynamicResource TextMuted}" Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Timeout de sessão (min)" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtSessionTimeout" Style="{DynamicResource InputBox}"
                                     LostFocus="OnSessionChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Alerta de doc. parado (h)" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtStaleHours" Style="{DynamicResource InputBox}"
                                     LostFocus="OnStaleChanged"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══ Backup ═══ -->
            <Border Grid.Row="4" Grid.Column="2" Style="{DynamicResource Card}">
                <StackPanel>
                    <TextBlock Text="Backup Automático" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                    <TextBlock Text="Cópia periódica do banco SQLite." FontSize="11"
                               Foreground="{DynamicResource TextMuted}" Margin="0,0,0,16"/>

                    <TextBlock Text="Pasta de destino" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="..." Width="36" Padding="6,4"
                                Click="OnPickBackupFolder"/>
                        <TextBox x:Name="txtBackupFolder" Style="{DynamicResource InputBox}"
                                 LostFocus="OnBackupChanged" Margin="0,0,8,0"/>
                    </DockPanel>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Intervalo (h)" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtBackupInterval" Style="{DynamicResource InputBox}"
                                     LostFocus="OnBackupChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Máx. arquivos" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtBackupMax" Style="{DynamicResource InputBox}"
                                     LostFocus="OnBackupChanged"/>
                        </StackPanel>
                    </Grid>

                    <Button Style="{DynamicResource BtnGhost}" Content="Executar backup agora"
                            Click="OnBackupNow" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- ═══ OCR ═══ -->
            <Border Grid.Row="6" Grid.Column="0" Style="{DynamicResource Card}">
                <StackPanel>
                    <TextBlock Text="OCR" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                    <TextBlock Text="Leitura óptica de documentos" FontSize="11"
                               Foreground="{DynamicResource TextMuted}" Margin="0,0,0,20"/>

                    <TextBlock Text="Engine" FontSize="11.5" FontWeight="Medium"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                    <ComboBox SelectedIndex="0" Padding="8,6" FontSize="11.5" Margin="0,0,0,16"
                              Background="{DynamicResource BgInput}" Foreground="{DynamicResource TextPrimary}">
                        <ComboBoxItem>PyMuPDF (PDF nativo)</ComboBoxItem>
                        <ComboBoxItem>Tesseract OCR (imagens)</ComboBoxItem>
                    </ComboBox>

                    <CheckBox Content="Correção de rotação" IsChecked="True"
                              Foreground="{DynamicResource TextPrimary}" FontSize="11.5" Margin="0,0,0,8"/>
                    <CheckBox Content="Remoção de ruído" IsChecked="True"
                              Foreground="{DynamicResource TextPrimary}" FontSize="11.5"/>
                </StackPanel>
            </Border>

            <!-- ═══ Telemetria ═══ -->
            <Border Grid.Row="6" Grid.Column="2" Style="{DynamicResource Card}">
                <StackPanel>
                    <TextBlock Text="Telemetria Local" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                    <TextBlock Text="Contadores locais — nenhum dado deixa o computador."
                               FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,16"/>

                    <CheckBox x:Name="chkTelemetry" Content="Habilitar contadores locais (opt-in)"
                              Foreground="{DynamicResource TextPrimary}" FontSize="11.5" Margin="0,0,0,12"
                              Click="OnTelemetryChanged"/>

                    <TextBlock x:Name="txtTelemetryStats" Text="" FontFamily="Consolas" FontSize="10.5"
                               Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>

                    <Button Style="{DynamicResource BtnGhost}" Content="Zerar contadores"
                            Click="OnResetTelemetry" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <!-- ═══ Segurança ═══ -->
            <Border Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" Style="{DynamicResource Card}">
                <StackPanel>
                    <TextBlock Text="Segurança e LGPD" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,14"/>
                    <UniformGrid Columns="3">
                        <Border Background="{DynamicResource SuccessBg}" CornerRadius="6" Padding="12" Margin="0,0,8,0"
                                BorderBrush="#1A2da565" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Processamento 100% Local" FontSize="12" FontWeight="Medium"
                                           Foreground="{DynamicResource Success}"/>
                                <TextBlock Text="Nenhum dado enviado para nuvem" FontSize="10"
                                           Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource SuccessBg}" CornerRadius="6" Padding="12" Margin="4,0"
                                BorderBrush="#1A2da565" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="PBKDF2 + Auditoria" FontSize="12" FontWeight="Medium"
                                           Foreground="{DynamicResource Success}"/>
                                <TextBlock Text="Senhas com 120k iterações; toda ação fica registrada" FontSize="10"
                                           Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource SuccessBg}" CornerRadius="6" Padding="12" Margin="8,0,0,0"
                                BorderBrush="#1A2da565" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Banco de Dados Local" FontSize="12" FontWeight="Medium"
                                           Foreground="{DynamicResource Success}"/>
                                <TextBlock Text="SQLite em %LocalAppData%\OContabil" FontSize="10"
                                           Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
