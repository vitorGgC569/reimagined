<Window x:Class="OContabil.Views.DocumentReviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Revisão de Documento" Height="780" Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgPrimary}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI"
        Loaded="OnLoaded">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="txtFilename" Text="Filename.pdf" FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Border x:Name="badgeType" CornerRadius="4" Padding="6,2" Background="{DynamicResource InfoBg}">
                    <TextBlock x:Name="txtType" Text="NFS-e" Foreground="{DynamicResource Info}" FontSize="12" FontWeight="Bold"/>
                </Border>
                <Border x:Name="badgeStatus" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                    <TextBlock x:Name="txtStatus" Text="ReadyForReview" FontSize="12" FontWeight="Bold"/>
                </Border>
                <TextBlock x:Name="txtConfidence" Text="Confiança: 95%" Margin="16,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondary}"/>
                <TextBlock x:Name="txtUploadedBy" Text="" Margin="16,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMuted}" FontSize="11"/>
            </StackPanel>
        </StackPanel>

        <!-- Tabs -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Padding" Value="14,8"/>
                    <Setter Property="FontSize" Value="12.5"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
            </TabControl.Resources>

            <!-- Tab 1: Revisão -->
            <TabItem Header="Revisão">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="4*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Native Document Viewer -->
                    <Border Grid.Column="0" Style="{DynamicResource Card}" Padding="0" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Documento Original" FontWeight="SemiBold" FontSize="14"
                                       Margin="16,16,16,12" Foreground="{DynamicResource TextPrimary}"/>
                            <wv2:WebView2 x:Name="docViewer" Grid.Row="1"/>
                        </Grid>
                    </Border>

                    <!-- Right: OCR + Status -->
                    <Border Grid.Column="2" Style="{DynamicResource Card}" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Texto Extraído (OCR)" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBox x:Name="txtOcr" Grid.Row="1" Style="{DynamicResource InputBox}"
                                     IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                                     FontSize="11" Margin="0,0,0,16"/>

                            <StackPanel Grid.Row="2">
                                <TextBlock Text="Status da Revisão" Foreground="{DynamicResource TextSecondary}"
                                           Margin="0,0,0,4"/>
                                <ComboBox x:Name="cmbStatus" Padding="8,6" FontSize="11.5"
                                          Background="{DynamicResource BgInput}"
                                          Foreground="{DynamicResource TextPrimary}"
                                          SelectionChanged="OnStatusChanged">
                                    <ComboBoxItem Content="Pendente" Tag="0"/>
                                    <ComboBoxItem Content="Processando" Tag="1"/>
                                    <ComboBoxItem Content="Revisar" Tag="2"/>
                                    <ComboBoxItem Content="Validado" Tag="3"/>
                                    <ComboBoxItem Content="Rejeitado" Tag="4"/>
                                    <ComboBoxItem Content="Erro" Tag="5"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Rejection reason (visible when status is Rejected/Error) -->
                            <StackPanel x:Name="pnlReason" Grid.Row="3" Margin="0,12,0,0" Visibility="Collapsed">
                                <TextBlock Text="Motivo da rejeição *" Foreground="{DynamicResource Warning}"
                                           Margin="0,0,0,4" FontWeight="SemiBold"/>
                                <TextBox x:Name="txtReason" Style="{DynamicResource InputBox}"
                                         Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>

                            <StackPanel Grid.Row="4" Margin="0,12,0,0">
                                <TextBlock Text="Observações" Foreground="{DynamicResource TextSecondary}"
                                           Margin="0,0,0,4"/>
                                <TextBlock x:Name="txtMetadata" FontSize="11"
                                           Foreground="{DynamicResource TextMuted}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 2: Campos Extraídos -->
            <TabItem Header="Campos Extraídos">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{DynamicResource Card}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <TextBlock Text="Editar Campos" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Corrija valores extraídos pela IA. As alterações são gravadas no campo JSON."
                                           FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="pnlFields"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{DynamicResource Card}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <DockPanel>
                                    <TextBlock Text="JSON Bruto" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" DockPanel.Dock="Left"/>
                                    <Button Content="Restaurar Original" Style="{DynamicResource BtnGhost}"
                                            HorizontalAlignment="Right" Click="OnRestoreOriginal"
                                            DockPanel.Dock="Right" Padding="8,4" FontSize="11"/>
                                </DockPanel>
                                <TextBlock Text="Editado livremente — clique em Salvar para aplicar."
                                           FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <TextBox x:Name="txtJson" Style="{DynamicResource InputBox}"
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                                     FontSize="11"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 3: Histórico -->
            <TabItem Header="Histórico de Revisões">
                <Border Style="{DynamicResource Card}" Margin="0,12,0,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock Text="Trilha de Auditoria" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="Toda alteração manual fica registrada com usuário, data e diff."
                                       FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <DataGrid x:Name="gridHistory" AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="Transparent" BorderThickness="0"
                                  Foreground="{DynamicResource TextPrimary}" FontSize="12"
                                  RowBackground="Transparent" AlternatingRowBackground="Transparent"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource Border}"
                                  HeadersVisibility="Column" CanUserResizeRows="False">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{DynamicResource BgElevated}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                    <Setter Property="FontSize" Value="10"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="12,8"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="12,6"/>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="DATA" Binding="{Binding RevisedAtStr}" Width="140"/>
                                <DataGridTextColumn Header="USUÁRIO" Binding="{Binding UserName}" Width="150"/>
                                <DataGridTextColumn Header="DE" Binding="{Binding FromStatus}" Width="100"/>
                                <DataGridTextColumn Header="PARA" Binding="{Binding ToStatus}" Width="100"/>
                                <DataGridTextColumn Header="MOTIVO" Binding="{Binding Reason}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <DockPanel Grid.Row="2" Margin="0,20,0,0" LastChildFill="False">
            <Button Style="{DynamicResource BtnGhost}" Content="Cancelar" Click="OnCancel"
                    DockPanel.Dock="Left" Width="100"/>
            <Button Style="{DynamicResource BtnPrimary}" Content="Salvar Alterações"
                    Click="OnSave" DockPanel.Dock="Right" Width="180"/>
        </DockPanel>
    </Grid>
</Window>
