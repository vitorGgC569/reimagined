void JambaModel::backward_external(const Tensor &grad, Context &ctx) {
  backward(grad, ctx);
}

void JambaModel::backward_embedding(const Tensor &grad, Context &ctx) {
  if (embedding) {
    embedding->backward(grad);
  }
}
